module

public import ErdosSzekeres.StructuralChargingTransitionHallReflection

@[expose] public section

/-!
# Child-ray bridge to reflected endpoint-transition candidates

At the unique lowest decomposition node separating a retained span, its exact
parent rank is generated by one exact child ray.  The ray direction depends on
the span color and on which child contains its left endpoint.

This file selects the endpoint profile incident to that child ray and proves
that, after the same orientation reflection used by the Hall construction, it
is an available transition candidate.  This is an incidence bridge only: it
does not assert that the selected representatives are injective or prove the
remaining Hall expansion.
-/

namespace ErdosSzekeres

noncomputable section

/-- The exact child ray incident to a crossing span, normalized by the child
containing its left endpoint. -/
def AllocatedExactRankActiveRay {n rank : ℕ} (chi : TripleColoring n)
    (lower upper : Finset (Fin n)) (color : Turn)
    (span : SweepSpanEndpoints n) : Prop :=
  match color with
  | .left =>
      if span.left ∈ lower then
        HasExactCupRightRayRank chi lower span.left span.right (rank - 1)
      else
        HasExactCupLeftRayRank chi lower span.left span.right (rank - 1)
  | .right =>
      if span.left ∈ lower then
        HasExactCapLeftRayRank chi upper span.left span.right (rank - 1)
      else
        HasExactCapRightRayRank chi upper span.left span.right (rank - 1)

/-- Every exact-rank crossing span exposes its orientation-normalized child
ray. -/
theorem allocatedExactRankSpan_has_activeRay
    {n rank : ℕ} {chi : TripleColoring n}
    {lower upper : Finset (Fin n)} {color : Turn}
    (hdeep : HasDeepBelowSplit chi lower upper) (hrank : 3 ≤ rank)
    {span : SweepSpanEndpoints n}
    (hspan : span ∈ allocatedExactRankSpans chi lower upper color rank) :
    AllocatedExactRankActiveRay (rank := rank)
      chi lower upper color span := by
  cases color with
  | left =>
      obtain ⟨_, hsides⟩ :=
        (mem_allocatedExactRankSpans_left_iff_rays hdeep hrank).mp hspan
      rcases hsides with hsides | hsides
      · simpa [AllocatedExactRankActiveRay, hsides.1] using hsides.2.2
      · have hnotLower : span.left ∉ lower := by
          intro hleftLower
          exact (Finset.disjoint_left.mp hdeep.disjoint hleftLower hsides.1).elim
        simpa [AllocatedExactRankActiveRay, hnotLower] using hsides.2.2
  | right =>
      obtain ⟨_, hsides⟩ :=
        (mem_allocatedExactRankSpans_right_iff_rays hdeep hrank).mp hspan
      rcases hsides with hsides | hsides
      · simpa [AllocatedExactRankActiveRay, hsides.1] using hsides.2.2
      · have hnotLower : span.left ∉ lower := by
          intro hleftLower
          exact (Finset.disjoint_left.mp hdeep.disjoint hleftLower hsides.1).elim
        simpa [AllocatedExactRankActiveRay, hnotLower] using hsides.2.2

/-- The unique lowest separating-node allocation turns an exact parent span
into the corresponding active child ray. -/
theorem LowestSeparatedSpanAllocation.hasActiveRay_of_exactRank
    {n rank : ℕ} {chi : TripleColoring n} {s : Finset (Fin n)}
    {tree : DecompositionTree chi s} {a b : Fin n} {color : Turn}
    (allocation : LowestSeparatedSpanAllocation chi tree a b)
    (hab : a < b)
    (hexact : HasExactSpanRank color chi
      (allocation.node.lower ∪ allocation.node.upper) ⟨a, b⟩ rank)
    (hrank : 3 ≤ rank) :
    AllocatedExactRankActiveRay (rank := rank) chi
      allocation.node.lower allocation.node.upper color ⟨a, b⟩ := by
  apply allocatedExactRankSpan_has_activeRay allocation.node.deep hrank
  rw [mem_allocatedExactRankSpans]
  exact ⟨⟨hab, allocation.opposite_children⟩, hexact⟩

/-- Choose the endpoint profile incident to the active child ray.  The
propositional test is true exactly for a future ray at the left endpoint; the
other case uses a past ray at the right endpoint. -/
def allocatedActiveEndpointRankTransitionCandidate
    {n : ℕ} {Ideal : Type*} [Fintype Ideal] [DecidableEq Ideal]
    {chi : TripleColoring n} {lower upper : Finset (Fin n)}
    {color : Turn} {rank k : ℕ}
    (profiles : AllocatedEndpointTransitionProfiles
      chi lower upper color rank k Ideal)
    (span : {span // span ∈
      allocatedExactRankFrontier chi lower upper color rank}) : Ideal :=
  if color = .left ↔ span.1.left ∈ lower then
    profiles.future span.1.left
  else
    profiles.past span.1.right

/-- The active endpoint profile is one of the original two-endpoint
transition candidates. -/
theorem allocatedActiveEndpointRankTransitionCandidate_mem
    {n : ℕ} {Ideal : Type*} [Fintype Ideal] [DecidableEq Ideal]
    [Lattice Ideal] [DecidableLE Ideal]
    {chi : TripleColoring n} {lower upper : Finset (Fin n)}
    {color : Turn} {rank k : ℕ}
    (profiles : AllocatedEndpointTransitionProfiles
      chi lower upper color rank k Ideal)
    (span : {span // span ∈
      allocatedExactRankFrontier chi lower upper color rank}) :
    allocatedActiveEndpointRankTransitionCandidate profiles span ∈
      allocatedEndpointTransitionCandidates profiles span := by
  rw [allocatedActiveEndpointRankTransitionCandidate]
  split
  · rw [allocatedEndpointTransitionCandidates, Finset.mem_union]
    exact Or.inl (pascalTransitionInterval_second_mem _ _)
  · rw [allocatedEndpointTransitionCandidates, Finset.mem_union]
    exact Or.inr (pascalTransitionInterval_first_mem _ _)

/-- Keep the whole endpoint interval incident to the active child ray.  This
is the smallest interval already present in the two-endpoint candidate family
that contains the distinguished active profile. -/
def allocatedActiveEndpointRankTransitionCandidates
    {n : ℕ} {Ideal : Type*} [Fintype Ideal] [DecidableEq Ideal]
    [Lattice Ideal] [DecidableLE Ideal]
    {chi : TripleColoring n} {lower upper : Finset (Fin n)}
    {color : Turn} {rank k : ℕ}
    (profiles : AllocatedEndpointTransitionProfiles
      chi lower upper color rank k Ideal)
    (span : {span // span ∈
      allocatedExactRankFrontier chi lower upper color rank}) : Finset Ideal :=
  if color = .left ↔ span.1.left ∈ lower then
    pascalTransitionInterval (profiles.past span.1.left)
      (profiles.future span.1.left)
  else
    pascalTransitionInterval (profiles.past span.1.right)
      (profiles.future span.1.right)

/-- The distinguished active profile lies in its active endpoint interval. -/
theorem allocatedActiveEndpointRankTransitionCandidate_mem_activeCandidates
    {n : ℕ} {Ideal : Type*} [Fintype Ideal] [DecidableEq Ideal]
    [Lattice Ideal] [DecidableLE Ideal]
    {chi : TripleColoring n} {lower upper : Finset (Fin n)}
    {color : Turn} {rank k : ℕ}
    (profiles : AllocatedEndpointTransitionProfiles
      chi lower upper color rank k Ideal)
    (span : {span // span ∈
      allocatedExactRankFrontier chi lower upper color rank}) :
    allocatedActiveEndpointRankTransitionCandidate profiles span ∈
      allocatedActiveEndpointRankTransitionCandidates profiles span := by
  rw [allocatedActiveEndpointRankTransitionCandidate,
    allocatedActiveEndpointRankTransitionCandidates]
  split
  · exact pascalTransitionInterval_second_mem _ _
  · exact pascalTransitionInterval_first_mem _ _

/-- The active endpoint interval is a subfamily of the original two-endpoint
transition candidates. -/
theorem allocatedActiveEndpointRankTransitionCandidates_subset
    {n : ℕ} {Ideal : Type*} [Fintype Ideal] [DecidableEq Ideal]
    [Lattice Ideal] [DecidableLE Ideal]
    {chi : TripleColoring n} {lower upper : Finset (Fin n)}
    {color : Turn} {rank k : ℕ}
    (profiles : AllocatedEndpointTransitionProfiles
      chi lower upper color rank k Ideal)
    (span : {span // span ∈
      allocatedExactRankFrontier chi lower upper color rank}) :
    allocatedActiveEndpointRankTransitionCandidates profiles span ⊆
      allocatedEndpointTransitionCandidates profiles span := by
  rw [allocatedActiveEndpointRankTransitionCandidates,
    allocatedEndpointTransitionCandidates]
  split
  · exact Finset.subset_union_left
  · exact Finset.subset_union_right

/-- Apply the split-orientation reflection to the active endpoint profile. -/
def allocatedReflectedActiveEndpointRankTransitionCandidate
    {n rank k : ℕ} (chi : TripleColoring n)
    (lower upper : Finset (Fin n)) (color : Turn)
    (hrank : 1 ≤ rank) (hrankTop : rank < k)
    (span : {span // span ∈
      allocatedExactRankFrontier chi lower upper color rank}) :
    PascalGridIdeal (rank - 1) (k - rank - 1) :=
  let profiles := allocatedEndpointRankTransitionProfiles
    chi lower upper color hrank hrankTop
  let candidate :=
    allocatedActiveEndpointRankTransitionCandidate profiles span
  if span.1.left ∈ lower then candidate
  else PascalGridIdeal.reflectedComplement candidate

/-- Apply the split-orientation reflection to every ideal in the active
endpoint interval. -/
def allocatedReflectedActiveEndpointRankTransitionCandidates
    {n rank k : ℕ} (chi : TripleColoring n)
    (lower upper : Finset (Fin n)) (color : Turn)
    (hrank : 1 ≤ rank) (hrankTop : rank < k)
    (span : {span // span ∈
      allocatedExactRankFrontier chi lower upper color rank}) :
    Finset (PascalGridIdeal (rank - 1) (k - rank - 1)) :=
  let profiles := allocatedEndpointRankTransitionProfiles
    chi lower upper color hrank hrankTop
  let candidates :=
    allocatedActiveEndpointRankTransitionCandidates profiles span
  if span.1.left ∈ lower then candidates
  else candidates.map
    (PascalGridIdeal.reflectedComplementEquiv
      (rank - 1) (k - rank - 1)).toEmbedding

/-- The reflected distinguished profile lies in the reflected active endpoint
interval. -/
theorem allocatedReflectedActiveEndpointRankTransitionCandidate_mem_activeCandidates
    {n rank k : ℕ} (chi : TripleColoring n)
    (lower upper : Finset (Fin n)) (color : Turn)
    (hrank : 1 ≤ rank) (hrankTop : rank < k)
    (span : {span // span ∈
      allocatedExactRankFrontier chi lower upper color rank}) :
    allocatedReflectedActiveEndpointRankTransitionCandidate
        chi lower upper color hrank hrankTop span ∈
      allocatedReflectedActiveEndpointRankTransitionCandidates
        chi lower upper color hrank hrankTop span := by
  classical
  let profiles := allocatedEndpointRankTransitionProfiles
    chi lower upper color hrank hrankTop
  have hcandidate :
      allocatedActiveEndpointRankTransitionCandidate profiles span ∈
        allocatedActiveEndpointRankTransitionCandidates profiles span :=
    allocatedActiveEndpointRankTransitionCandidate_mem_activeCandidates
      profiles span
  by_cases hleft : span.1.left ∈ lower
  · simpa [allocatedReflectedActiveEndpointRankTransitionCandidate,
      allocatedReflectedActiveEndpointRankTransitionCandidates, profiles,
      hleft] using hcandidate
  · rw [allocatedReflectedActiveEndpointRankTransitionCandidate,
      allocatedReflectedActiveEndpointRankTransitionCandidates]
    simp only [hleft, ↓reduceIte, Finset.mem_map, Equiv.toEmbedding_apply]
    exact ⟨allocatedActiveEndpointRankTransitionCandidate profiles span,
      hcandidate, rfl⟩

/-- Reflection preserves the inclusion of the active endpoint interval in the
full two-endpoint candidate family. -/
theorem allocatedReflectedActiveEndpointRankTransitionCandidates_subset
    {n rank k : ℕ} (chi : TripleColoring n)
    (lower upper : Finset (Fin n)) (color : Turn)
    (hrank : 1 ≤ rank) (hrankTop : rank < k)
    (span : {span // span ∈
      allocatedExactRankFrontier chi lower upper color rank}) :
    allocatedReflectedActiveEndpointRankTransitionCandidates
        chi lower upper color hrank hrankTop span ⊆
      allocatedReflectedEndpointRankTransitionCandidates
        chi lower upper color hrank hrankTop span := by
  classical
  let profiles := allocatedEndpointRankTransitionProfiles
    chi lower upper color hrank hrankTop
  have hsubset :
      allocatedActiveEndpointRankTransitionCandidates profiles span ⊆
        allocatedEndpointTransitionCandidates profiles span :=
    allocatedActiveEndpointRankTransitionCandidates_subset profiles span
  by_cases hleft : span.1.left ∈ lower
  · simpa [allocatedReflectedActiveEndpointRankTransitionCandidates,
      allocatedReflectedEndpointRankTransitionCandidates, profiles, hleft]
      using hsubset
  · rw [allocatedReflectedActiveEndpointRankTransitionCandidates,
      allocatedReflectedEndpointRankTransitionCandidates]
    simp only [hleft, ↓reduceIte]
    intro ideal hideal
    rw [Finset.mem_map] at hideal ⊢
    obtain ⟨source, hsource, rfl⟩ := hideal
    exact ⟨source, hsubset hsource, rfl⟩

/-- The reflected active endpoint profile belongs to the reflected candidate
set. -/
theorem allocatedReflectedActiveEndpointRankTransitionCandidate_mem
    {n rank k : ℕ} (chi : TripleColoring n)
    (lower upper : Finset (Fin n)) (color : Turn)
    (hrank : 1 ≤ rank) (hrankTop : rank < k)
    (span : {span // span ∈
      allocatedExactRankFrontier chi lower upper color rank}) :
    allocatedReflectedActiveEndpointRankTransitionCandidate
        chi lower upper color hrank hrankTop span ∈
      allocatedReflectedEndpointRankTransitionCandidates
        chi lower upper color hrank hrankTop span := by
  classical
  let profiles := allocatedEndpointRankTransitionProfiles
    chi lower upper color hrank hrankTop
  have hcandidate :
      allocatedActiveEndpointRankTransitionCandidate profiles span ∈
        allocatedEndpointTransitionCandidates profiles span :=
    allocatedActiveEndpointRankTransitionCandidate_mem profiles span
  by_cases hleft : span.1.left ∈ lower
  · simpa [allocatedReflectedActiveEndpointRankTransitionCandidate,
      allocatedReflectedEndpointRankTransitionCandidates, profiles, hleft] using
      hcandidate
  · rw [allocatedReflectedActiveEndpointRankTransitionCandidate,
      allocatedReflectedEndpointRankTransitionCandidates]
    simp only [hleft, ↓reduceIte, Finset.mem_map, Equiv.toEmbedding_apply]
    exact ⟨allocatedActiveEndpointRankTransitionCandidate profiles span,
      hcandidate, rfl⟩

/-- At a deep-below split, every retained exact-rank span supplies both its
actual active child ray and an incident reflected transition candidate. -/
theorem allocatedExactRankFrontier_activeRay_and_reflectedCandidate
    {n rank k : ℕ} {chi : TripleColoring n}
    {lower upper : Finset (Fin n)} {color : Turn}
    (hdeep : HasDeepBelowSplit chi lower upper)
    (hrank : 3 ≤ rank) (hrankTop : rank < k)
    (span : {span // span ∈
      allocatedExactRankFrontier chi lower upper color rank}) :
    AllocatedExactRankActiveRay (rank := rank)
        chi lower upper color span.1 ∧
      allocatedReflectedActiveEndpointRankTransitionCandidate
          chi lower upper color (by omega) hrankTop span ∈
        allocatedReflectedEndpointRankTransitionCandidates
          chi lower upper color (by omega) hrankTop span := by
  refine ⟨allocatedExactRankSpan_has_activeRay hdeep hrank ?_, ?_⟩
  · exact (mem_allocatedExactRankFrontier.mp span.2).1
  · exact allocatedReflectedActiveEndpointRankTransitionCandidate_mem
      chi lower upper color (by omega) hrankTop span

/-- Specialize the bridge to the unique lowest decomposition node allocated
to the two endpoints in a fixed explicit tree. -/
theorem LowestSeparatedSpanAllocation.frontier_activeRay_and_reflectedCandidate
    {n rank k : ℕ} {chi : TripleColoring n} {s : Finset (Fin n)}
    {tree : DecompositionTree chi s} {a b : Fin n} {color : Turn}
    (allocation : LowestSeparatedSpanAllocation chi tree a b)
    (hrank : 3 ≤ rank) (hrankTop : rank < k)
    (hfrontier : (⟨a, b⟩ : SweepSpanEndpoints n) ∈
      allocatedExactRankFrontier chi allocation.node.lower
        allocation.node.upper color rank) :
    let span : {span // span ∈
        allocatedExactRankFrontier chi allocation.node.lower
          allocation.node.upper color rank} := ⟨⟨a, b⟩, hfrontier⟩
    AllocatedExactRankActiveRay (rank := rank) chi
        allocation.node.lower allocation.node.upper color span.1 ∧
      allocatedReflectedActiveEndpointRankTransitionCandidate chi
          allocation.node.lower allocation.node.upper color (by omega)
          hrankTop span ∈
        allocatedReflectedEndpointRankTransitionCandidates chi
          allocation.node.lower allocation.node.upper color (by omega)
          hrankTop span := by
  dsimp only
  exact allocatedExactRankFrontier_activeRay_and_reflectedCandidate
    allocation.node.deep hrank hrankTop ⟨⟨a, b⟩, hfrontier⟩

end

end ErdosSzekeres

