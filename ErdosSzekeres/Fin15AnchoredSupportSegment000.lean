/-! Semantic helper facts in bounded group 000. -/

theorem fin15Anchored_strongSet_iff_mask00031 (chi : TripleColoring 15) :
    IsStrongPolygonSet chi {0, 1, 2, 3, 4} ↔
      Fin15AnchoredStrongQuad chi 0 1 2 3 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 0 1 2 4 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 0 1 3 4 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 0 2 3 4 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 1 2 3 4 (by decide) (by decide) (by decide) := by
  constructor
  · intro h
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 0) (j := 1) (k := 2) (l := 3)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 0) (j := 1) (k := 2) (l := 4)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 0) (j := 1) (k := 3) (l := 4)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 0) (j := 2) (k := 3) (l := 4)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 1) (j := 2) (k := 3) (l := 4)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
  · rintro ⟨h0, h1, h2, h3, h4⟩ i j k l hij hjk hkl hi hj hk hl
    simp only [Finset.mem_insert, Finset.mem_singleton] at hi hj hk hl
    rcases hi with rfl | rfl | rfl | rfl | rfl <;>
      rcases hj with rfl | rfl | rfl | rfl | rfl <;>
      rcases hk with rfl | rfl | rfl | rfl | rfl <;>
      rcases hl with rfl | rfl | rfl | rfl | rfl <;> try omega
    all_goals simp_all [Fin15AnchoredStrongQuad]

