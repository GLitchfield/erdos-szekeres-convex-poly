theorem fin15Anchored_strongSet_iff_mask22660 (chi : TripleColoring 15) :
    IsStrongPolygonSet chi {2, 7, 11, 12, 14} ↔
      Fin15AnchoredStrongQuad chi 2 7 11 12 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 2 7 11 14 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 2 7 12 14 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 2 11 12 14 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 7 11 12 14 (by decide) (by decide) (by decide) := by
  constructor
  · intro h
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 2) (j := 7) (k := 11) (l := 12)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 2) (j := 7) (k := 11) (l := 14)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 2) (j := 7) (k := 12) (l := 14)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 2) (j := 11) (k := 12) (l := 14)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 7) (j := 11) (k := 12) (l := 14)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
  · rintro ⟨h0, h1, h2, h3, h4⟩ i j k l hij hjk hkl hi hj hk hl
    simp only [Finset.mem_insert, Finset.mem_singleton] at hi hj hk hl
    rcases hi with rfl | rfl | rfl | rfl | rfl <;>
      rcases hj with rfl | rfl | rfl | rfl | rfl <;>
