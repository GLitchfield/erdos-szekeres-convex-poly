/-! Semantic helper facts in bounded group 000. -/

theorem predecessorHalfFin13_strongSet_iff_mask0061 (chi : TripleColoring 13) :
    IsStrongPolygonSet chi {0, 2, 3, 4, 5} ↔
      PredecessorHalfFin13StrongQuad chi 0 2 3 4 (by decide) (by decide) (by decide) ∧
      PredecessorHalfFin13StrongQuad chi 0 2 3 5 (by decide) (by decide) (by decide) ∧
      PredecessorHalfFin13StrongQuad chi 0 2 4 5 (by decide) (by decide) (by decide) ∧
      PredecessorHalfFin13StrongQuad chi 0 3 4 5 (by decide) (by decide) (by decide) ∧
      PredecessorHalfFin13StrongQuad chi 2 3 4 5 (by decide) (by decide) (by decide) := by
  constructor
  · intro h
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · simpa [PredecessorHalfFin13StrongQuad] using h
        (i := 0) (j := 2) (k := 3) (l := 4)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [PredecessorHalfFin13StrongQuad] using h
        (i := 0) (j := 2) (k := 3) (l := 5)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [PredecessorHalfFin13StrongQuad] using h
        (i := 0) (j := 2) (k := 4) (l := 5)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [PredecessorHalfFin13StrongQuad] using h
        (i := 0) (j := 3) (k := 4) (l := 5)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [PredecessorHalfFin13StrongQuad] using h
        (i := 2) (j := 3) (k := 4) (l := 5)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
  · rintro ⟨h0, h1, h2, h3, h4⟩ i j k l hij hjk hkl hi hj hk hl
    simp only [Finset.mem_insert, Finset.mem_singleton] at hi hj hk hl
    rcases hi with rfl | rfl | rfl | rfl | rfl <;>
      rcases hj with rfl | rfl | rfl | rfl | rfl <;>
      rcases hk with rfl | rfl | rfl | rfl | rfl <;>
      rcases hl with rfl | rfl | rfl | rfl | rfl <;> try omega
    all_goals simp_all [PredecessorHalfFin13StrongQuad]

