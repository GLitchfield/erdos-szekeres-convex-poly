theorem fin15Anchored_strongSet_iff_mask17058 (chi : TripleColoring 15) :
    IsStrongPolygonSet chi {1, 5, 7, 9, 14} ↔
      Fin15AnchoredStrongQuad chi 1 5 7 9 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 1 5 7 14 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 1 5 9 14 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 1 7 9 14 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 5 7 9 14 (by decide) (by decide) (by decide) := by
  constructor
  · intro h
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 1) (j := 5) (k := 7) (l := 9)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 1) (j := 5) (k := 7) (l := 14)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 1) (j := 5) (k := 9) (l := 14)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 1) (j := 7) (k := 9) (l := 14)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 5) (j := 7) (k := 9) (l := 14)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
  · rintro ⟨h0, h1, h2, h3, h4⟩ i j k l hij hjk hkl hi hj hk hl
    simp only [Finset.mem_insert, Finset.mem_singleton] at hi hj hk hl
    rcases hi with rfl | rfl | rfl | rfl | rfl <;>
      rcases hj with rfl | rfl | rfl | rfl | rfl <;>
