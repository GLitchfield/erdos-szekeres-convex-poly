      (chi ⟨3, 7, 14, by decide, by decide⟩ = Turn.left) ∧
      (chi ⟨3, 9, 14, by decide, by decide⟩ = Turn.left) ∧
      (chi ⟨4, 7, 9, by decide, by decide⟩ = Turn.left) ∧
      (chi ⟨4, 7, 14, by decide, by decide⟩ = Turn.left) ∧
