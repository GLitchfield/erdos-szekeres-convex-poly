    ¬(¬(chi ⟨0, 1, 3, by decide, by decide⟩ = Turn.left) ∧
      ¬(chi ⟨0, 1, 5, by decide, by decide⟩ = Turn.left) ∧
      ¬(chi ⟨0, 1, 8, by decide, by decide⟩ = Turn.left) ∧
      ¬(chi ⟨0, 1, 10, by decide, by decide⟩ = Turn.left) ∧
