      Fin15AnchoredStrongQuad chi 2 3 6 10 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 2 3 6 14 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 2 3 10 14 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 2 6 10 14 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 3 6 10 14 (by decide) (by decide) (by decide) := by
  constructor
  · intro h
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 2) (j := 3) (k := 6) (l := 10)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 2) (j := 3) (k := 6) (l := 14)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 2) (j := 3) (k := 10) (l := 14)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 2) (j := 6) (k := 10) (l := 14)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 3) (j := 6) (k := 10) (l := 14)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
  · rintro ⟨h0, h1, h2, h3, h4⟩ i j k l hij hjk hkl hi hj hk hl
    simp only [Finset.mem_insert, Finset.mem_singleton] at hi hj hk hl
