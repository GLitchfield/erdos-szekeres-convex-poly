theorem fin15Anchored_strongSet_iff_mask18563 (chi : TripleColoring 15) :
    IsStrongPolygonSet chi {0, 1, 7, 11, 14} ↔
      Fin15AnchoredStrongQuad chi 0 1 7 11 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 0 1 7 14 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 0 1 11 14 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 0 7 11 14 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 1 7 11 14 (by decide) (by decide) (by decide) := by
  constructor
  · intro h
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 0) (j := 1) (k := 7) (l := 11)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 0) (j := 1) (k := 7) (l := 14)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 0) (j := 1) (k := 11) (l := 14)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 0) (j := 7) (k := 11) (l := 14)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 1) (j := 7) (k := 11) (l := 14)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
  · rintro ⟨h0, h1, h2, h3, h4⟩ i j k l hij hjk hkl hi hj hk hl
    simp only [Finset.mem_insert, Finset.mem_singleton] at hi hj hk hl
