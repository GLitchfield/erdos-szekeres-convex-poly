        (chi ⟨b, c, d, hbc, hcd⟩))
    (hno : ∀ f : Fin 6 ↪o Fin 17, ¬ IsStrongPolygonOn chi f)
    (hanchor : chi.IsAnchored) :
    ¬((chi ⟨2, 4, 6, by decide, by decide⟩ = Turn.left) ∧
      (chi ⟨2, 4, 9, by decide, by decide⟩ = Turn.left) ∧
      (chi ⟨2, 4, 10, by decide, by decide⟩ = Turn.left) ∧
