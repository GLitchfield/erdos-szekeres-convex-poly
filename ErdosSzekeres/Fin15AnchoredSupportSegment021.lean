theorem fin15Anchored_strongSet_iff_mask12481 (chi : TripleColoring 15) :
    IsStrongPolygonSet chi {0, 6, 7, 12, 13} ↔
      Fin15AnchoredStrongQuad chi 0 6 7 12 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 0 6 7 13 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 0 6 12 13 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 0 7 12 13 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 6 7 12 13 (by decide) (by decide) (by decide) := by
  constructor
  · intro h
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 0) (j := 6) (k := 7) (l := 12)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 0) (j := 6) (k := 7) (l := 13)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 0) (j := 6) (k := 12) (l := 13)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 0) (j := 7) (k := 12) (l := 13)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 6) (j := 7) (k := 12) (l := 13)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
  · rintro ⟨h0, h1, h2, h3, h4⟩ i j k l hij hjk hkl hi hj hk hl
    simp only [Finset.mem_insert, Finset.mem_singleton] at hi hj hk hl
    rcases hi with rfl | rfl | rfl | rfl | rfl <;>
      rcases hj with rfl | rfl | rfl | rfl | rfl <;>
      rcases hk with rfl | rfl | rfl | rfl | rfl <;>
      rcases hl with rfl | rfl | rfl | rfl | rfl <;> try omega
    all_goals simp_all [Fin15AnchoredStrongQuad]

