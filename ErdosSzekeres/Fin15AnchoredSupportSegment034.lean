theorem fin15Anchored_strongSet_iff_mask19474 (chi : TripleColoring 15) :
    IsStrongPolygonSet chi {1, 4, 10, 11, 14} ↔
      Fin15AnchoredStrongQuad chi 1 4 10 11 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 1 4 10 14 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 1 4 11 14 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 1 10 11 14 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 4 10 11 14 (by decide) (by decide) (by decide) := by
  constructor
  · intro h
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 1) (j := 4) (k := 10) (l := 11)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 1) (j := 4) (k := 10) (l := 14)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 1) (j := 4) (k := 11) (l := 14)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 1) (j := 10) (k := 11) (l := 14)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 4) (j := 10) (k := 11) (l := 14)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
  · rintro ⟨h0, h1, h2, h3, h4⟩ i j k l hij hjk hkl hi hj hk hl
    simp only [Finset.mem_insert, Finset.mem_singleton] at hi hj hk hl
    rcases hi with rfl | rfl | rfl | rfl | rfl <;>
      rcases hj with rfl | rfl | rfl | rfl | rfl <;>
      rcases hk with rfl | rfl | rfl | rfl | rfl <;>
      rcases hl with rfl | rfl | rfl | rfl | rfl <;> try omega
    all_goals simp_all [Fin15AnchoredStrongQuad]

