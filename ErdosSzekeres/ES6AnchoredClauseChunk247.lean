      ¬(chi ⟨4, 8, 12, by decide, by decide⟩ = Turn.left) ∧
      (chi ⟨4, 10, 12, by decide, by decide⟩ = Turn.left) ∧
      ¬(chi ⟨6, 8, 10, by decide, by decide⟩ = Turn.left) ∧
      ¬(chi ⟨6, 8, 12, by decide, by decide⟩ = Turn.left) ∧
