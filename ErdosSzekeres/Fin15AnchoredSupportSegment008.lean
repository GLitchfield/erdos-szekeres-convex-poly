theorem fin15Anchored_strongSet_iff_mask09229 (chi : TripleColoring 15) :
    IsStrongPolygonSet chi {0, 2, 3, 10, 13} ↔
      Fin15AnchoredStrongQuad chi 0 2 3 10 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 0 2 3 13 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 0 2 10 13 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 0 3 10 13 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 2 3 10 13 (by decide) (by decide) (by decide) := by
  constructor
  · intro h
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 0) (j := 2) (k := 3) (l := 10)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 0) (j := 2) (k := 3) (l := 13)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 0) (j := 2) (k := 10) (l := 13)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 0) (j := 3) (k := 10) (l := 13)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 2) (j := 3) (k := 10) (l := 13)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
  · rintro ⟨h0, h1, h2, h3, h4⟩ i j k l hij hjk hkl hi hj hk hl
    simp only [Finset.mem_insert, Finset.mem_singleton] at hi hj hk hl
    rcases hi with rfl | rfl | rfl | rfl | rfl <;>
      rcases hj with rfl | rfl | rfl | rfl | rfl <;>
