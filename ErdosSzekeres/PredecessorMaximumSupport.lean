module

public import ErdosSzekeres.StrongPredecessorBicoloring

@[expose] public section

/-!
# Maximum predecessor-free supports

This file isolates the noncircular first step of the maximum-support charging
route.  Maximal cardinality forces every exterior vertex to complete a
predecessor-sized strong polygon with an anchor inside the support.  No
matching, injection, or half-cardinality conclusion is assumed here.
-/

namespace ErdosSzekeres

/-- A maximum-cardinality subset avoiding a strong predecessor polygon. -/
def IsMaximumPredecessorFreeSupport {n : ℕ} (χ : TripleColoring n)
    (k : ℕ) (support : Finset (Fin n)) : Prop :=
  ¬ContainsStrongPolygonSet χ support (k - 1) ∧
    ∀ candidate : Finset (Fin n),
      ¬ContainsStrongPolygonSet χ candidate (k - 1) →
        candidate.card ≤ support.card

/-- A concrete predecessor witness generated by adjoining one exterior
vertex to an anchor contained in a predecessor-free support. -/
def ExteriorPredecessorAnchor {n : ℕ} (χ : TripleColoring n) (k : ℕ)
    (support : Finset (Fin n)) (vertex : Fin n)
    (anchor : Finset (Fin n)) : Prop :=
  vertex ∉ support ∧ anchor ⊆ support ∧ anchor.card = k - 2 ∧
    IsStrongPolygonSet χ (insert vertex anchor)

/-- The noncircular exterior-to-support relation for later Hall or weighted
charging arguments.  Eligibility means that the support vertex participates
in some concrete predecessor anchor; it contains no matching or cardinal
conclusion. -/
def ExteriorPredecessorChargeEligible {n : ℕ} (χ : TripleColoring n)
    (k : ℕ) (support : Finset (Fin n)) (vertex owner : Fin n) : Prop :=
  vertex ∉ support ∧ owner ∈ support ∧
    ∃ anchor : Finset (Fin n),
      anchor ⊆ support ∧ anchor.card = k - 2 ∧ owner ∈ anchor ∧
        IsStrongPolygonSet χ (insert vertex anchor)

/-- Every vertex outside a maximum predecessor-free support has a
`(k-2)`-point anchor inside it.  Otherwise adjoining the vertex would produce
a larger predecessor-free support. -/
theorem IsMaximumPredecessorFreeSupport.exists_exteriorAnchor
    {n k : ℕ} {χ : TripleColoring n} {support : Finset (Fin n)}
    (hmaximum : IsMaximumPredecessorFreeSupport χ k support)
    {vertex : Fin n} (hvertex : vertex ∉ support) :
    ∃ anchor : Finset (Fin n),
      ExteriorPredecessorAnchor χ k support vertex anchor := by
  have hinsertContains :
      ContainsStrongPolygonSet χ (insert vertex support) (k - 1) := by
    by_contra hinsertFree
    have hcardLe := hmaximum.2 (insert vertex support) hinsertFree
    rw [Finset.card_insert_of_notMem hvertex] at hcardLe
    omega
  obtain ⟨polygon, hpolygonSub, hpolygonCard, hpolygonStrong⟩ :=
    hinsertContains
  have hvertexPolygon : vertex ∈ polygon := by
    by_contra hvertexNotPolygon
    apply hmaximum.1
    refine ⟨polygon, ?_, hpolygonCard, hpolygonStrong⟩
    intro x hxPolygon
    have hxInsert := hpolygonSub hxPolygon
    rcases Finset.mem_insert.mp hxInsert with rfl | hxSupport
    · exact (hvertexNotPolygon hxPolygon).elim
    · exact hxSupport
  let anchor := polygon.erase vertex
  have hanchorSub : anchor ⊆ support := by
    intro x hxAnchor
    have hxData := Finset.mem_erase.mp hxAnchor
    have hxInsert := hpolygonSub hxData.2
    rcases Finset.mem_insert.mp hxInsert with hxeq | hxSupport
    · exact (hxData.1 hxeq).elim
    · exact hxSupport
  have hanchorCard : anchor.card = k - 2 := by
    simp only [anchor]
    rw [Finset.card_erase_of_mem hvertexPolygon, hpolygonCard]
    omega
  have hinsertAnchor : insert vertex anchor = polygon := by
    simp only [anchor]
    exact Finset.insert_erase hvertexPolygon
  exact ⟨anchor, hvertex, hanchorSub, hanchorCard,
    hinsertAnchor ▸ hpolygonStrong⟩

/-- Each exterior vertex has an eligible neighborhood containing an entire
predecessor anchor.  The still-open step is a collision/Hall theorem comparing
these neighborhoods for several exterior vertices. -/
theorem IsMaximumPredecessorFreeSupport.exists_eligibleNeighborhood
    {n k : ℕ} {χ : TripleColoring n} {support : Finset (Fin n)}
    (hmaximum : IsMaximumPredecessorFreeSupport χ k support)
    {vertex : Fin n} (hvertex : vertex ∉ support) :
    ∃ neighborhood : Finset (Fin n),
      neighborhood ⊆ support ∧ neighborhood.card = k - 2 ∧
        ∀ owner ∈ neighborhood,
          ExteriorPredecessorChargeEligible χ k support vertex owner := by
  obtain ⟨anchor, hvertexAnchor, hanchorSub, hanchorCard, hanchorStrong⟩ :=
    hmaximum.exists_exteriorAnchor hvertex
  exact ⟨anchor, hanchorSub, hanchorCard, fun owner howner ↦
    ⟨hvertexAnchor, hanchorSub howner,
      anchor, hanchorSub, hanchorCard, howner, hanchorStrong⟩⟩

end ErdosSzekeres
