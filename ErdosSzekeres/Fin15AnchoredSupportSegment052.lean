theorem fin15Anchored_strongSet_iff_mask04520 (chi : TripleColoring 15) :
    IsStrongPolygonSet chi {3, 5, 7, 8, 12} ↔
      Fin15AnchoredStrongQuad chi 3 5 7 8 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 3 5 7 12 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 3 5 8 12 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 3 7 8 12 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 5 7 8 12 (by decide) (by decide) (by decide) := by
  constructor
  · intro h
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 3) (j := 5) (k := 7) (l := 8)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 3) (j := 5) (k := 7) (l := 12)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 3) (j := 5) (k := 8) (l := 12)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 3) (j := 7) (k := 8) (l := 12)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 5) (j := 7) (k := 8) (l := 12)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
  · rintro ⟨h0, h1, h2, h3, h4⟩ i j k l hij hjk hkl hi hj hk hl
    simp only [Finset.mem_insert, Finset.mem_singleton] at hi hj hk hl
    rcases hi with rfl | rfl | rfl | rfl | rfl <;>
      rcases hj with rfl | rfl | rfl | rfl | rfl <;>
