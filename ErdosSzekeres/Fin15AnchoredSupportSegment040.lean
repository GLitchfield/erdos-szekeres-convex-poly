theorem fin15Anchored_strongSet_iff_mask00812 (chi : TripleColoring 15) :
    IsStrongPolygonSet chi {2, 3, 5, 8, 9} ↔
      Fin15AnchoredStrongQuad chi 2 3 5 8 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 2 3 5 9 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 2 3 8 9 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 2 5 8 9 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 3 5 8 9 (by decide) (by decide) (by decide) := by
  constructor
  · intro h
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 2) (j := 3) (k := 5) (l := 8)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 2) (j := 3) (k := 5) (l := 9)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 2) (j := 3) (k := 8) (l := 9)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 2) (j := 5) (k := 8) (l := 9)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 3) (j := 5) (k := 8) (l := 9)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
  · rintro ⟨h0, h1, h2, h3, h4⟩ i j k l hij hjk hkl hi hj hk hl
    simp only [Finset.mem_insert, Finset.mem_singleton] at hi hj hk hl
    rcases hi with rfl | rfl | rfl | rfl | rfl <;>
      rcases hj with rfl | rfl | rfl | rfl | rfl <;>
      rcases hk with rfl | rfl | rfl | rfl | rfl <;>
      rcases hl with rfl | rfl | rfl | rfl | rfl <;> try omega
    all_goals simp_all [Fin15AnchoredStrongQuad]

