      (chi ⟨7, 13, 16, by decide, by decide⟩ = Turn.left) ∧
      ¬(chi ⟨7, 14, 16, by decide, by decide⟩ = Turn.left) ∧
      (chi ⟨8, 13, 14, by decide, by decide⟩ = Turn.left) ∧
