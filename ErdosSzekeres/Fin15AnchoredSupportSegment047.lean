theorem fin15Anchored_strongSet_iff_mask05700 (chi : TripleColoring 15) :
    IsStrongPolygonSet chi {2, 6, 9, 10, 12} ↔
      Fin15AnchoredStrongQuad chi 2 6 9 10 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 2 6 9 12 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 2 6 10 12 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 2 9 10 12 (by decide) (by decide) (by decide) ∧
      Fin15AnchoredStrongQuad chi 6 9 10 12 (by decide) (by decide) (by decide) := by
  constructor
  · intro h
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 2) (j := 6) (k := 9) (l := 10)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 2) (j := 6) (k := 9) (l := 12)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 2) (j := 6) (k := 10) (l := 12)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 2) (j := 9) (k := 10) (l := 12)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
    · simpa [Fin15AnchoredStrongQuad] using h
        (i := 6) (j := 9) (k := 10) (l := 12)
        (by decide) (by decide) (by decide)
        (by simp) (by simp) (by simp) (by simp)
  · rintro ⟨h0, h1, h2, h3, h4⟩ i j k l hij hjk hkl hi hj hk hl
    simp only [Finset.mem_insert, Finset.mem_singleton] at hi hj hk hl
