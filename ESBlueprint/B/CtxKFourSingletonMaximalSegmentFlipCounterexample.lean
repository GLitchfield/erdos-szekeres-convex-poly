namespace ErdosSzekeres

set_option maxHeartbeats 8000000
set_option maxRecDepth 10000

/-- A well-formed k=4 six-child interleaved partition, with both global limits equal to four, has value three at a legal coupling. Its only singleton maximal homogeneous segments are children6 and7; both flips have value at most two at every legal coupling and orientation. Witness word1U,S,S,S,S,1U,S,S and maxima1, keep1,2,6. Certifies the singleton-only exchange obstruction already at the first positive k boundary. Does not refute exchange by whole maximal segments of arbitrary length.
@node
@ws B
@kind formalization
@consumer ErdosSzekeres.ctx_bound_additive_multi_run -/
theorem ctx_k_four_singleton_maximal_segment_flip_counterexample : ∃ σ : Ctx.Context, σ.WellFormed ∧ σ.a = 4 ∧ σ.u = 4 ∧ σ.k = 4 ∧ σ.childPositions = [1, 2, 3, 4, 6, 7] ∧ 2 ≤ σ.numRuns ∧ [1, 2, 6] ∉ σ.blocks ∧ [3, 4, 7] ∉ σ.blocks ∧ (σ.part [1, 2, 6] .lower 1).bound + (σ.part [3, 4, 7] .upper 2).bound = 3 ∧ ∀ d, 1 ≤ d → d ≤ σ.k - 2 → (σ.part [1, 2] .lower d).bound + (σ.part [3, 4, 6, 7] .upper (σ.k - 1 - d)).bound ≤ 2 ∧ (σ.part [1, 2] .upper (σ.k - 1 - d)).bound + (σ.part [3, 4, 6, 7] .lower d).bound ≤ 2 ∧ (σ.part [1, 2, 6, 7] .lower d).bound + (σ.part [3, 4] .upper (σ.k - 1 - d)).bound ≤ 2 ∧ (σ.part [1, 2, 6, 7] .upper (σ.k - 1 - d)).bound + (σ.part [3, 4] .lower d).bound ≤ 2 := by
  classical
  have f0 : (⟨4, 4, 4, [Ctx.Letter.ext 3 Ctx.Side.upper, Ctx.Letter.child, Ctx.Letter.ext 1 Ctx.Side.lower, Ctx.Letter.ext 2 Ctx.Side.lower, Ctx.Letter.ext 2 Ctx.Side.lower, Ctx.Letter.ext 3 Ctx.Side.upper, Ctx.Letter.ext 1 Ctx.Side.lower, Ctx.Letter.ext 2 Ctx.Side.lower], [1, 1, 1]⟩ : Ctx.Context).bound ≤ 1 := by
    as_aux_lemma =>
      let C : Ctx.Context := ⟨4, 4, 4, [Ctx.Letter.ext 3 Ctx.Side.upper, Ctx.Letter.child, Ctx.Letter.ext 1 Ctx.Side.lower, Ctx.Letter.ext 2 Ctx.Side.lower, Ctx.Letter.ext 2 Ctx.Side.lower, Ctx.Letter.ext 3 Ctx.Side.upper, Ctx.Letter.ext 1 Ctx.Side.lower, Ctx.Letter.ext 2 Ctx.Side.lower], [1, 1, 1]⟩
      change C.bound ≤ 1
      have hr : C.numRuns ≤ 1 := by decide +kernel
      have hb : C.base ≤ 1 := by decide +kernel
      unfold Ctx.Context.bound
      rw [Ctx.Context.boundFuel.eq_2, if_pos hr]
      exact hb
  have f1 : (⟨4, 4, 4, [Ctx.Letter.ext 3 Ctx.Side.upper, Ctx.Letter.ext 1 Ctx.Side.upper, Ctx.Letter.child, Ctx.Letter.ext 2 Ctx.Side.lower, Ctx.Letter.ext 2 Ctx.Side.lower, Ctx.Letter.ext 3 Ctx.Side.upper, Ctx.Letter.child, Ctx.Letter.ext 2 Ctx.Side.lower], [2, 1, 1]⟩ : Ctx.Context).bound ≤ 1 := by
