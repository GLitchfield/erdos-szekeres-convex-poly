      (ν.part (ν.childPositions.filter (fun p ↦ p ∉ [3, 4, 6])) Ctx.Side.upper 3).bound = 3 := by
    have hc : ν.part (ν.childPositions.filter (fun p ↦ p ∉ [3, 4, 6])) Ctx.Side.upper 3 = (⟨6, 6, 6, [Ctx.Letter.ext 2 Ctx.Side.lower, Ctx.Letter.ext 2 Ctx.Side.lower, Ctx.Letter.ext 3 Ctx.Side.lower, Ctx.Letter.ext 1 Ctx.Side.upper, Ctx.Letter.ext 1 Ctx.Side.upper, Ctx.Letter.ext 4 Ctx.Side.upper, Ctx.Letter.ext 1 Ctx.Side.upper, Ctx.Letter.child, Ctx.Letter.ext 5 Ctx.Side.lower, Ctx.Letter.child, Ctx.Letter.child], [3, 2, 1, 2, 1]⟩ : Ctx.Context) := by rfl
    rw [hc]
    exact Nat.le_antisymm f4200 f4203
  refine ⟨hwf, hstruct, ⟨hA, hB, hsmall, hleft, hright⟩, ?_⟩
  have hcut := (ctx_bound_cut_le ν (by decide +kernel) [3, 4, 6] (by decide +kernel)
    2 (by decide) (by decide)).1
  change (ν.part [3, 4, 6] Ctx.Side.lower 2).bound +
    (ν.part (ν.childPositions.filter (fun p ↦ p ∉ [3, 4, 6])) Ctx.Side.upper 3).bound ≤ ν.bound at hcut
  rw [hleft, hright] at hcut
  have hlow : 6 ≤ ν.bound := hcut
  change (ρ.part K Ctx.Side.lower 2).bound +
    (ρ.part (ρ.childPositions.filter (fun p ↦ p ∉ K)) Ctx.Side.upper 3).bound ≤ ν.bound + τ.bound
  rw [hA, hB, hsmall]
  exact Nat.add_le_add_right hlow 3



end ErdosSzekeres
