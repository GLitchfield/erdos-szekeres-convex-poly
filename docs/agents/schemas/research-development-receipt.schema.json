{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/erdos-szekeres/research-development-receipt.schema.json",
  "title": "Erdos-Szekeres evidence-first development receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "brief_id", "brief_sha256", "execution_envelope", "terminal", "assigned_gate_outcome", "evidence_events", "resource_use", "claim_candidate", "serendipity", "route_action", "admission_status"],
  "properties": {
    "schema_version": {"const": 3},
    "brief_id": {"type": "string", "minLength": 1},
    "brief_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_envelope": {"$ref": "#/$defs/fileReceipt"},
    "terminal": {"enum": ["GATE_POSITIVE_SIGNAL", "GATE_FALSIFIER", "NO_DISCRIMINATING_SIGNAL", "OPERATIONAL_STOP"]},
    "assigned_gate_outcome": {"type": "string", "minLength": 1, "maxLength": 1600},
    "evidence_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event_id", "kind", "claim_level", "gate_branch", "binding", "artifact", "verification_receipt", "observation"],
        "properties": {
          "event_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "kind": {"enum": ["checked_computation", "exact_falsifier", "reproducible_unexplained_invariant", "claim_refuted", "proposal_only"]},
          "claim_level": {"enum": ["proposal", "computational_evidence"]},
          "gate_branch": {"enum": ["live", "kill", "no_signal", "sidecar"]},
          "binding": {
            "type": "object", "additionalProperties": false,
            "required": ["primary_contract_id", "subject", "subject_contract_id", "model_contract_id", "scope_contract_id", "polarity", "damage_scope_reached"],
            "properties": {
              "primary_contract_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "subject": {"enum": ["primary_claim", "shared_premise"]},
              "subject_contract_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "model_contract_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "scope_contract_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "polarity": {"enum": ["supports", "refutes", "observes"]},
              "damage_scope_reached": {"enum": ["candidate-local", "subfamily"]}
            }
          },
          "artifact": {"$ref": "#/$defs/fileReceipt"},
          "verification_receipt": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/fileReceipt"}]},
          "observation": {"type": "string", "minLength": 1, "maxLength": 2000}
        }
      }
    },
    "resource_use": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_minutes", "active_minutes", "cpu_seconds", "peak_memory_mib", "artifact_bytes", "input_tokens", "output_tokens", "tool_calls", "source_requests", "experiment_runs", "checker_runs"],
      "properties": {
        "wall_minutes": {"type": ["number", "null"], "minimum": 0},
        "active_minutes": {"type": ["number", "null"], "minimum": 0},
        "cpu_seconds": {"type": ["number", "null"], "minimum": 0},
        "peak_memory_mib": {"type": ["number", "null"], "minimum": 0},
        "artifact_bytes": {"type": ["integer", "null"], "minimum": 0},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "tool_calls": {"type": ["integer", "null"], "minimum": 0},
        "source_requests": {"type": ["integer", "null"], "minimum": 0},
        "experiment_runs": {"type": ["integer", "null"], "minimum": 0},
        "checker_runs": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "claim_candidate": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["contract_id", "model_contract_id", "scope_contract_id", "evidence_event_ids", "downstream"],
          "properties": {
            "contract_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "model_contract_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "scope_contract_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "evidence_event_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
            "downstream": {"const": "verification_funnel_required"}
          }
        }
      ]
    },
    "serendipity": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["statement_or_observation", "model_tier", "scope_ceiling", "relation_to_assigned_probe", "evidence_event_ids", "contains_claim_candidate", "downstream"],
          "properties": {
            "statement_or_observation": {"type": "string", "minLength": 1, "maxLength": 2400},
            "model_tier": {"type": "string", "minLength": 1, "maxLength": 1200},
            "scope_ceiling": {"type": "string", "minLength": 1, "maxLength": 1200},
            "relation_to_assigned_probe": {"type": "string", "minLength": 1, "maxLength": 1200},
            "evidence_event_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
            "contains_claim_candidate": {"type": "boolean"},
            "downstream": {"const": "root_audit_required"}
          }
        }
      ]
    },
    "route_action": {"const": "none"},
    "admission_status": {"const": "unadmitted"}
  },
  "$defs": {
    "fileReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
