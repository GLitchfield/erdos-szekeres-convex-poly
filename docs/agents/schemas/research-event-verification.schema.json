{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/erdos-szekeres/research-event-verification.schema.json",
  "title": "Contract-bound research evidence verification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "protocol", "verifier_contract_id",
    "verification_request", "verification_envelope",
    "verifier_component", "claim_contract_id", "primary_contract_id",
    "subject_contract_id", "model_contract_id", "scope_contract_id",
    "verified_event_core_sha256", "event_artifact", "engine", "invocation",
    "input_receipts", "normalized_result", "guarded_runner", "makefile",
    "theorem_audit", "exit_code", "terminal"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "protocol": {"const": "research-event-verification-v3"},
    "verifier_contract_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verification_request": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/fileReceipt"}]},
    "verification_envelope": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/fileReceipt"}]},
    "verifier_component": {"$ref": "#/$defs/fileReceipt"},
    "claim_contract_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "primary_contract_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "subject_contract_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model_contract_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scope_contract_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "verified_event_core_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "event_artifact": {"$ref": "#/$defs/fileReceipt"},
    "engine": {"enum": ["python_exact", "exact_solver", "lean_native_decide", "lean_kernel"]},
    "invocation": {
      "type": "object", "additionalProperties": false,
      "required": ["argv", "cwd"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1}},
        "cwd": {"const": "."}
      }
    },
    "input_receipts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fileReceipt"}},
    "normalized_result": {"$ref": "#/$defs/normalizedResult"},
    "guarded_runner": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/fileReceipt"}]},
    "makefile": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/fileReceipt"}]},
    "theorem_audit": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/fileReceipt"}]},
    "exit_code": {"const": 0},
    "terminal": {"const": "PASS"}
  },
  "$defs": {
    "fileReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "normalizedResult": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "protocol", "verified_event_core_sha256",
        "event_artifact", "claim_contract_id", "primary_contract_id",
        "subject_contract_id", "model_contract_id", "scope_contract_id",
        "kind", "gate_branch", "polarity", "damage_scope_reached",
        "observation_sha256", "checked_predicate", "result",
        "verified_learning"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "protocol": {"const": "research-event-normalized-result-v1"},
        "verified_event_core_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "event_artifact": {"$ref": "#/$defs/fileReceipt"},
        "claim_contract_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "primary_contract_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "subject_contract_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "model_contract_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "scope_contract_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "kind": {"type": "string", "minLength": 1},
        "gate_branch": {"enum": ["live", "kill", "no_signal", "sidecar"]},
        "polarity": {"enum": ["supports", "refutes", "observes"]},
        "damage_scope_reached": {"enum": ["candidate-local", "subfamily"]},
        "observation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "checked_predicate": {"type": "string", "minLength": 1, "maxLength": 2000},
        "result": {"enum": ["supports", "refutes", "observes"]},
        "verified_learning": {
          "type": "object", "additionalProperties": false,
          "required": ["failing_feature", "strongest_supported_statement"],
          "properties": {
            "failing_feature": {"$ref": "#/$defs/verifiedLearningClaim"},
            "strongest_supported_statement": {"$ref": "#/$defs/verifiedLearningClaim"}
          }
        }
      }
    },
    "verifiedLearningClaim": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["learning_claim_id", "text", "subject_contract_id"],
          "properties": {
            "learning_claim_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "text": {"type": "string", "minLength": 1, "maxLength": 2000},
            "subject_contract_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      ]
    }
  }
}
