{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/erdos-szekeres/research-development-brief.schema.json",
  "title": "Erdos-Szekeres evidence-first development brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "brief_id", "task_id", "seed", "target_ref", "worker_mode", "evidence_contract", "probe", "selected_context", "hostile_controls", "allowed_methods", "lean_policy", "checkpoint_tool_calls", "persistence_instruction", "policies", "authority"],
  "properties": {
    "schema_version": {"const": 3},
    "brief_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["batch_path", "batch_sha256", "seed_id"],
      "properties": {
        "batch_path": {"type": "string", "minLength": 1},
        "batch_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "seed_id": {"type": "string", "minLength": 1}
      }
    },
    "target_ref": {"type": "string", "minLength": 1, "maxLength": 240},
    "worker_mode": {"enum": ["context_rich", "representation_escape", "failure_dual", "independent_replication"]},
    "evidence_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_id", "statement", "target_ref", "model", "model_contract_id", "scope", "theorem"],
      "properties": {
        "contract_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "statement": {"type": "string", "minLength": 1, "maxLength": 4000},
        "target_ref": {"type": "string", "minLength": 1, "maxLength": 240},
        "model": {
          "type": "object", "additionalProperties": false,
          "required": ["working_tier", "target_tier", "transfer_status", "bridge_ref", "information_at_risk"],
          "properties": {
            "working_tier": {"type": "string", "minLength": 1},
            "target_tier": {"type": "string", "minLength": 1},
            "transfer_status": {"enum": ["same_tier", "conjectural", "verified_bridge"]},
            "bridge_ref": {"type": ["string", "null"]},
            "information_at_risk": {"type": "string", "minLength": 1}
          }
        },
        "model_contract_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "scope": {
          "type": "object", "additionalProperties": false,
          "required": ["scope_contract_id", "candidate", "ceiling", "subfamily"],
          "properties": {
            "scope_contract_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "candidate": {
              "type": "object", "additionalProperties": false,
              "required": ["campaign_id", "seed_id", "seed_batch_sha256"],
              "properties": {
                "campaign_id": {"type": "string", "minLength": 1},
                "seed_id": {"type": "string", "minLength": 1},
                "seed_batch_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            },
            "ceiling": {"enum": ["candidate-local", "subfamily"]},
            "subfamily": {
              "oneOf": [
                {"type": "null"},
                {
                  "type": "object", "additionalProperties": false,
                  "required": ["subfamily_ref", "shared_premise", "shared_premise_contract_id"],
                  "properties": {
                    "subfamily_ref": {"type": "string", "minLength": 1},
                    "shared_premise": {"type": "string", "minLength": 1},
                    "shared_premise_contract_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
                  }
                }
              ]
            }
          }
        },
        "theorem": {"type": "null"}
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "assumption_refs", "actions", "live_signal", "kill_signal", "ceiling_minutes", "stop_condition"],
      "properties": {
        "question": {"type": "string", "minLength": 1, "maxLength": 2400},
        "assumption_refs": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 240}},
        "actions": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
        "live_signal": {"type": "string", "minLength": 1, "maxLength": 800},
        "kill_signal": {"type": "string", "minLength": 1, "maxLength": 800},
        "ceiling_minutes": {"type": "integer", "minimum": 1, "maximum": 30},
        "stop_condition": {"type": "string", "minLength": 1, "maxLength": 1000}
      }
    },
    "selected_context": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "purpose"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "purpose": {"type": "string", "minLength": 1, "maxLength": 600}
        }
      }
    },
    "hostile_controls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["control_id", "construction", "expected_if_mechanism_is_real", "expected_if_artifact", "stop_observation"],
        "properties": {
          "control_id": {"type": "string", "minLength": 1, "maxLength": 120},
          "construction": {"type": "string", "minLength": 1, "maxLength": 1000},
          "expected_if_mechanism_is_real": {"type": "string", "minLength": 1, "maxLength": 800},
          "expected_if_artifact": {"type": "string", "minLength": 1, "maxLength": 800},
          "stop_observation": {"type": "string", "minLength": 1, "maxLength": 800}
        }
      }
    },
    "allowed_methods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["local_python", "local_exact_solver"]}
    },
    "lean_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "theorem_contract_ref", "rationale"],
      "properties": {
        "mode": {"enum": ["not_yet", "post_survival_only", "post_discovery_certificate"]},
        "theorem_contract_ref": {"type": "null"},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 800}
      }
    },
    "checkpoint_tool_calls": {"type": "integer", "minimum": 1, "maximum": 10},
    "persistence_instruction": {"const": "The frozen target and conventions may not be weakened or replaced. Seek a proof, exact counterexample, strongest scoped obstruction, or explicitly inconclusive terminal. Continue only while an undepleted predeclared discriminating test remains within budget. Negative, empty, and inconclusive terminals are acceptable. Effort, prior belief, worker agreement, and failure to find a counterexample are not evidence. Do not infer that the requested conclusion is true or smuggle it into a premise."},
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persistence", "serendipity", "claims", "metrics"],
      "properties": {
        "persistence": {"const": "neutral-v1"},
        "serendipity": {"const": "scoped-sidecar-v1"},
        "claims": {"const": "verification-funnel-v1"},
        "metrics": {"const": "evidence-vector-v1"}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "approval_ref", "execution_class", "terminal_ceiling", "limits", "writes", "provider_calls", "service_starts", "scheduler_mutations", "canonical_writes", "external_writes", "installations", "destructive_actions"],
      "properties": {
        "protocol": {"const": "ticket-0119-standing-first-test-v1"},
        "approval_ref": {"const": "docs/wayfinder/tickets/0119-adopt-self-refilling-investigation-loop.md#approval-and-operational-inventory"},
        "execution_class": {"const": "pre_admission_information_gathering"},
        "terminal_ceiling": {"const": "has_legs_or_earlier"},
        "limits": {
          "type": "object", "additionalProperties": false,
          "required": ["wall_minutes", "cpu_cores", "memory_gib", "output_gib"],
          "properties": {
            "wall_minutes": {"const": 30}, "cpu_cores": {"const": 2},
            "memory_gib": {"const": 4}, "output_gib": {"const": 0.1}
          }
        },
        "writes": {"const": "exact_ignored_runs_agents_paths_only"},
        "provider_calls": {"const": 0}, "service_starts": {"const": 0},
        "scheduler_mutations": {"const": false}, "canonical_writes": {"const": false},
        "external_writes": {"const": false}, "installations": {"const": false},
        "destructive_actions": {"const": false}
      }
    }
  },
  "$defs": {
    "fileReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
